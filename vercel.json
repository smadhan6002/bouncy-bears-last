{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^bouncybearsupdate\\.vercel\\.app$"
        }
      ],
      "destination": "https://www.bouncybearsofficial.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^bouncybearsofficial\\.com$"
        }
      ],
      "destination": "https://www.bouncybearsofficial.com/:path*",
      "permanent": true
    }
  ]
}
