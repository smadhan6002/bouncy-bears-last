{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^bouncybearsupdate\\.vercel\\.app$"
        }
      ],
      "destination": "https://www.bouncybearsofficial.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^bouncybearsofficial\\.com$"
        }
      ],
      "destination": "https://www.bouncybearsofficial.com/:path*",
      "permanent": true
    }
  ]
}
